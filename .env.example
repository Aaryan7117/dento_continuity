# Copy to .env and fill in. Never commit .env: this repository is public.

# PostgreSQL (Supabase, Mumbai). Both strings come from the project's Connect dialog.
# A password containing @ or # must be percent-encoded (@ -> %40, # -> %23).
#   DATABASE_URL        transaction pooler, port 6543 (serverless-friendly; not for migrations)
#   DIRECT_DATABASE_URL session pooler or direct, port 5432 (used by the app and by Prisma Migrate)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Signs the staff session cookie and patient links. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# The clinic that scripts and the MCP server act as (the seed creates this one).
DENTO_CLINIC_ID="00000000-0000-4000-8000-000000000001"

# Public address embedded in patient links.
APP_BASE_URL="http://localhost:3000"

# Optional: folder holding a sherpa-onnx speech model. Defaults to ./models.
# VOICE_MODEL_DIR=""

# Optional: password given to the seeded staff accounts (default dento-demo-2026).
# SEED_PASSWORD=""
